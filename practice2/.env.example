# Скопируйте в .env и подставьте свои значения: copy .env.example .env
# Файл .env не коммитится (см. корневой .gitignore).

# PostgreSQL (должны совпадать с учётными в DATABASE_URL)
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me

# Booking service
DATABASE_URL=postgresql+psycopg2://booking:change-me@postgres:5432/booking
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Gateway
BOOKING_SERVICE_URL=http://booking-service:8001
