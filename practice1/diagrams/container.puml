@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container — Meeting Room Booking (docker-compose / practice2)

Person(employee, "Сотрудник")
Person(admin, "Офис-администратор")
System_Ext(notifier, "Почтовый / push-сервис")

System_Boundary(bookingSystem, "Meeting Room Booking") {
  Container(web, "Web UI", "React 19, Vite, nginx", "SPA бронирования и входа")
  Container(gateway, "API Gateway", "FastAPI, uvicorn", "Единая точка входа, /api, /metrics")
  Container(booking, "Booking Service", "FastAPI, SQLAlchemy", "Бизнес-логика, JWT, /metrics")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 16", "Комнаты, пользователи, брони")
  Container(cache, "Redis", "Redis 7", "Кэш и блокировки слотов")
}

Rel(employee, web, "HTTPS", "браузер :3000")
Rel(admin, web, "HTTPS", "браузер :3000")
Rel(web, gateway, "REST JSON", "HTTPS :8000")
Rel(gateway, booking, "Проксирование запросов", "HTTP :8001")
Rel(booking, pg, "CRUD", "SQL")
Rel(booking, cache, "Кэш / locks", "RESP")
Rel(booking, notifier, "Письма при добавлении участника", "SMTP (STARTTLS)")

SHOW_LEGEND()
@enduml
