{
  "title": "Meeting Rooms Booking",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Gateway RPS",
      "targets": [
        {
          "expr": "sum(rate(gateway_http_requests_total[1m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway P95 Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bookings Created",
      "targets": [
        {
          "expr": "sum(rate(bookings_created_total[1m]))"
        }
      ]
    }
  ]
}
