# Скопируйте в booking-secrets.yaml и задайте свои значения (файл booking-secrets.yaml в .gitignore).
# Пароль в DATABASE_URL должен совпадать с DATABASE_PASSWORD.
apiVersion: v1
kind: Secret
metadata:
  name: booking-secrets
type: Opaque
stringData:
  DATABASE_USER: booking
  DATABASE_PASSWORD: change-me-db
  DATABASE_URL: postgresql+psycopg2://booking:change-me-db@postgres:5432/booking
  BOOTSTRAP_ADMIN_PASSWORD: change-me-admin
  JWT_SECRET_KEY: change-me-jwt-signing-key
